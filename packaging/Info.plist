<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>NotchForge</string>
    <key>CFBundleExecutable</key>
    <string>notchforge</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>dev.notchforge.NotchForge</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>NotchForge</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__BUILD__</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- Agent app: no Dock icon, no main menu. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <!-- Permission explanations shown by macOS. -->
    <key>NSLocationUsageDescription</key>
    <string>NotchForge uses your approximate location only to show local weather in the notch.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>NotchForge uses your approximate location only to show local weather in the notch.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>NotchForge shows the battery level of your connected accessories. It reads them from the system and does not connect to devices.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>NotchForge asks Spotify and Apple Music what is playing so it can show the track, artwork and playlists in the notch, and sends them play, pause, skip and playlist commands you choose.</string>
</dict>
</plist>
